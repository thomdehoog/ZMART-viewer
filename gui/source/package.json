{
  "name": "zmart-viewer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "declarations": "tsc -p tsconfig.primitives.json",
    "check:unused": "knip",
    "build": "npm run typecheck && npm run declarations && node scripts/patch_neuroglancer.mjs --modules-only && node scripts/precompile-workers.mjs && node scripts/patch_neuroglancer.mjs && vite build && node scripts/copy-async-worker.mjs && node scripts/stamp-build.mjs",
    "postinstall": "node scripts/patch_neuroglancer.mjs --modules-only",
    "preview": "vite preview"
  },
  "dependencies": {
    "neuroglancer": "2.41.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "knip": "6.41.0",
    "typescript": "6.0.3",
    "vite": "^7.0.0"
  }
}
